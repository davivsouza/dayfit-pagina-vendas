# API do DayFit — origem dos planos e dos links de checkout da Cakto.
# Só é lida no servidor (build/revalidação). Padrão: produção.
DAYFIT_API_URL=https://dayfit-back-production.up.railway.app

# Plataforma de aulas para onde a aluna vai depois da compra.
NEXT_PUBLIC_PLATFORM_URL=https://www.vip.daymormano.online

# Ofertas da Cakto (fallback quando a API não responde).
# Precisam ser os MESMOS ids das envs CAKTO_OFFER_* do dayfit-back.
NEXT_PUBLIC_CAKTO_OFFER_MONTHLY=35nnpk4_1061823
NEXT_PUBLIC_CAKTO_OFFER_SEMIANNUAL=3a4yozy_1064085
